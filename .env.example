DATABASE_URL=postgresql+psycopg://know_rag:know_rag@postgres:5432/know_rag
REDIS_URL=redis://redis:6379/0
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_LLM_MODEL=qwen2.5:3b
OLLAMA_EMBEDDING_MODEL=bge-m3
OLLAMA_EMBEDDING_DIMENSION=1024
AUTO_EMBED_AFTER_PARSE=false
HYBRID_VECTOR_WEIGHT=0.7
HYBRID_KEYWORD_WEIGHT=0.3
HYBRID_FUSION_STRATEGY=rrf
RRF_K=60
RRF_VECTOR_WEIGHT=1.0
RRF_KEYWORD_WEIGHT=1.0
EMBEDDING_CONTENT_MAX_CHARS=6000
DEFAULT_EMBEDDING_TOP_K=10
DEFAULT_SCORE_THRESHOLD=0.3

# Elasticsearch BM25 keyword retrieval
KEYWORD_SEARCH_BACKEND=elasticsearch
ELASTICSEARCH_URL=http://elasticsearch:9200
ELASTICSEARCH_INDEX=know_rag_chunks
ELASTICSEARCH_TIMEOUT_SECONDS=10
# Application-side BM25 query safety limits. Long queries are compressed and
# stop using ngram fields; no Elasticsearch cluster setting change is required.
ELASTICSEARCH_QUERY_MAX_CHARS=256
ELASTICSEARCH_QUERY_MAX_TERMS=24
ELASTICSEARCH_NGRAM_QUERY_MAX_CHARS=64
ELASTICSEARCH_SAFE_QUERY_MAX_CHARS=96
# Keep false for real BM25. Set true only for emergency fallback to legacy SQL ILIKE.
ELASTICSEARCH_FALLBACK_TO_SQL=false
DEFAULT_CHUNK_SIZE=512
DEFAULT_CHUNK_OVERLAP=80
CHUNK_STRATEGY=auto
CHUNK_SEPARATORS=\n\n|\n|。|.|；|;|，|,| 
ENABLE_PARENT_CHILD_CHUNKING=false
PARENT_CHUNK_SIZE=4096
CHILD_CHUNK_SIZE=384
CHILD_CHUNK_OVERLAP=64
# Document-relation rollout switches. Graph shadow generation is independent
# from Chunk materialization and retrieval expansion.
DOCUMENT_RELATION_GRAPH_ENABLED=false
DOCUMENT_RELATION_MATERIALIZATION_ENABLED=false
DOCUMENT_RELATION_RETRIEVAL_EXPANSION_ENABLED=false
DOCUMENT_ASSET_GROUP_ENABLED=false
DOCUMENT_PAGE_VISUAL_PRESERVATION_ENABLED=false
DOCUMENT_PAGE_VISUAL_MIN_COVERAGE=0.70
DOCUMENT_PAGE_VISUAL_RENDER_DPI=144
LOCAL_STORAGE_DIR=/data/files
LOCAL_CACHE_DIR=/data/cache
STORAGE_BACKEND=minio
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=know-rag
MINIO_SECURE=false
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
PDF_PARSER_PREFERENCE=auto
MINERU_BASE_URL=http://host.docker.internal:8000
MINERU_API_KEY=

# ── Document parser engine ──────────────────────────────────────────────
# Options: auto | deepdoc | ragflow | mineru
DOCUMENT_PARSER_ENGINE=mineru
# Comma-separated priority list: mineru,ragflow,legacy
PARSER_PRIORITY=mineru,ragflow,legacy
# MinerU parse endpoint (appended to MINERU_BASE_URL)
MINERU_PARSE_ENDPOINT=/file_parse
# Comma-separated extensions that MinerU can handle
MINERU_SUPPORTED_EXTENSIONS=pdf,png,jpg,jpeg,webp,doc,docx,ppt,pptx,xls,xlsx,html,txt,md,json,epub
# MinerU backend: pipeline (CPU) | hybrid-auto-engine (GPU) | vlm-auto-engine (GPU) | vlm-http-client | hybrid-http-client
# CPU environments MUST use pipeline. hybrid-auto-engine / vlm-auto-engine require CUDA/GPU.
MINERU_BACKEND=pipeline
MINERU_PARSE_METHOD=auto
MINERU_LANG=ch
MINERU_ENABLE_FORMULA=true
MINERU_ENABLE_TABLE=true
MINERU_TIMEOUT_SECONDS=300
MINERU_FALLBACK_TO_DEEPDOC=true
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
JWT_SECRET=dev-only-change-me

# ── Login captcha ────────────────────────────────────────────────────────
LOGIN_CAPTCHA_ENABLED=true
LOGIN_CAPTCHA_TTL_SECONDS=300
KNOW_RAG_SERVICE_TOKEN=
# Phase G optional vector store presets:
# - postgres / pgvector is default and always available
# - qdrant can be started with: docker compose --profile qdrant up -d --build
# - milvus/zilliz can be configured from the UI using uri/token/collection

# Phase H optional DeepDoc production model runtime
# Put RAGFlow/DeepDoc model files under /data/models/deepdoc, or point these to absolute paths.
DEEPDOC_MODEL_DIR=/data/models/deepdoc
DEEPDOC_LAYOUT_MODEL=
DEEPDOC_TSR_MODEL=
DEEPDOC_XGB_MODEL=
DEEPDOC_OCR_ENGINE=auto
DEEPDOC_AUTO_DOWNLOAD=1
# Optional external service exposing POST /layout and POST /tsr with normalized detection output.
DEEPDOC_SERVICE_URL=
DEEPDOC_SCORE_THRESHOLD=0.35
DEEPDOC_XGB_MERGE_THRESHOLD=0.52

# DeepDoc production model bootstrap. Keep enabled to match RAGFlow Docker experience.
DEEPDOC_AUTO_DOWNLOAD=1
DEEPDOC_MODEL_DIR=/data/models/deepdoc
DEEPDOC_HF_REPO=InfiniFlow/deepdoc
DEEPDOC_XGB_HF_REPO=InfiniFlow/text_concat_xgb_v1.0
# Optional mirror for China/intranet, for example: https://hf-mirror.com
HF_ENDPOINT=https://huggingface.co
DEEPDOC_DOWNLOAD_TIMEOUT=60

#Minueru parse result cache delete after parse, set true to save disk space, set false to keep parse result for debugging or future use.
LOCAL_CACHE_DIR=/data/cache
MINERU_OUTPUT_DIR=D:/know_rag_cache/mineru_output
CLEANUP_PARSE_CACHE_AFTER_PARSE=true

# ── Dockerized MinerU runtime profiles ──────────────────────────────────
# Default local/enterprise deployment: MinerU runs inside docker-compose.
# Backend should call service names, never Windows paths / host.docker.internal.
MINERU_RUNTIME_PROFILE=cpu
MINERU_BASE_URL=http://mineru-cpu:8000
MINERU_CPU_BASE_URL=http://mineru-cpu:8000
MINERU_GPU_BASE_URL=http://mineru-gpu:8000
MINERU_CPU_BACKEND=pipeline
MINERU_GPU_BACKEND=vlm-auto-engine
MINERU_CPU_PARSE_METHOD=auto
MINERU_GPU_PARSE_METHOD=auto
MINERU_OUTPUT_DIR=/data/cache
MINERU_SEND_OUTPUT_DIR=true
MINERU_LEGACY_OUTPUT_DIR=/data/cache/output
CLEANUP_MINERU_LEGACY_OUTPUT_AFTER_PARSE=true
# If the default pip package is not suitable for your MinerU version, override it:
# MINERU_PIP_SPEC=mineru[core]
# If your installed image needs a custom start command, override it:
# MINERU_CPU_API_COMMAND=mineru-api --host 0.0.0.0 --port 8000
# Start GPU service only when a GPU host is available:
# docker compose --profile gpu up -d --build mineru-gpu

# Parent-child retrieval context
RETRIEVAL_PARENT_CONTEXT_MAX_CHARS=2000
RETRIEVAL_NEIGHBOR_CONTEXT_MAX_CHARS=300
RETRIEVAL_PARENT_CHILDREN_LIMIT=30
RETRIEVAL_MAX_PARENT_CONTEXTS=5
RETRIEVAL_MERGE_HITS_BY_PARENT=true
RETRIEVAL_PARENT_GROUP_HIT_BONUS=0.05
RETRIEVAL_PARENT_CONTEXT_MODE=standard
LLM_CONTEXT_MAX_CHARS=8000
LLM_CONTEXT_MAX_SOURCES=8
LLM_CONTEXT_INCLUDE_IMAGES=true
LLM_CONTEXT_INCLUDE_IMAGE_URLS=false

# ── MCP Adapter ─────────────────────────────────────────────────────────
# Used when starting: python -m app.integrations.mcp.server
# Host-run MCP usually calls backend through 127.0.0.1:8000.
# A standalone MCP container can use http://backend:8000 instead.
KNOW_RAG_API_BASE=http://127.0.0.1:8000
# Optional. If omitted, MCP logs in with KNOW_RAG_USERNAME / KNOW_RAG_PASSWORD.
KNOW_RAG_API_TOKEN=
KNOW_RAG_USERNAME=admin
KNOW_RAG_PASSWORD=admin123
KNOW_RAG_API_TIMEOUT_SECONDS=60


# Remote MCP server
MCP_HOST=0.0.0.0
MCP_PORT=8010
MCP_MOUNT_PATH=/mcp
MCP_TRANSPORT=streamable-http

# MCP server calls Know_RAG API internally.
# In docker compose, use http://backend:8000.
KNOW_RAG_API_BASE=http://backend:8000

# ── Frontend ─────────────────────────────────────────────────────────────
# Used by MCP to construct document content page URLs returned to AI agents.
FRONTEND_BASE_URL=http://localhost:5174

# npm registry used only while building the frontend image. Override with
# https://registry.npmjs.org when the official registry is faster in your network.
NPM_REGISTRY=https://registry.npmmirror.com
